# 高德开放平台：应用类型必须选择 Web端(JS API)
AMAP_JS_KEY=替换为你的Web端Key
AMAP_SECURITY_CODE=替换为你的安全密钥
AMAP_CITY=深圳
# 公网真实地图应配置高德代理安全密钥地址，不向浏览器发送安全密钥。
AMAP_SERVICE_HOST=/_AMapService

# 批量采集默认间隔。建议先用 1200ms，按自己的配额和控制台情况调整。
COLLECT_DELAY_MS=1200

# 站粤公开只读服务（run_public.py）
# 设置后访问者必须在公开页面输入口令；留空表示无需口令。
ZHANYUE_PUBLIC_ACCESS_TOKEN=
ZHANYUE_PUBLIC_HOST=127.0.0.1
ZHANYUE_PUBLIC_PORT=8010

# 单 IP 每分钟最多读取的线路场景/真实地图数据次数。
ZHANYUE_PUBLIC_LINES_PER_MINUTE=30

# 只有在反向代理会覆盖 X-Forwarded-For 且不允许客户端伪造时才开启。
ZHANYUE_TRUST_PROXY=false

# 可选：覆盖公开服务读取的“衍生部署包”。这里绝不能指向精确数据目录。
# ZHANYUE_PUBLIC_BUNDLE_PATH=/absolute/path/to/zhanyue/dist/public
