+  letter-spacing: 0.8px;
+  color: var(--muted);
+  margin: 0 0 8px;
+  font-weight: 600;
+}
+
+.line-list { list-style: none; margin: 0; padding: 0; }
+.line-list li {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 5px 7px;
+  border-radius: 6px;
+  cursor: pointer;
+  user-select: none;
+}
+.line-list li:hover { background: var(--panel-2); }
+.line-list li.selected { background: #1f2c3a; outline: 1px solid #2f4a63; }
+.line-list li .swatch {
+  width: 14px; height: 14px; border-radius: 4px; flex-shrink: 0;
+  border: 1px solid rgba(255,255,255,0.15);
+}
+.line-list li .name { flex: 1; }
+.line-list li.dim { opacity: 0.35; }
+
+.toggles { display: flex; flex-direction: column; gap: 5px; }
+.toggles label { display: flex; align-items: center; gap: 7px; cursor: pointer; }
+input[type="range"] { width: 100%; accent-color: var(--accent); }
+.num { color: var(--accent-2); font-variant-numeric: tabular-nums; }
+.hint { color: var(--muted); font-size: 11px; margin-top: 3px; }
+
+.diag { font-size: 12px; color: var(--text); }
+.diag .bad { color: var(--danger); }
+
+#canvasWrap { position: relative; overflow: hidden; background: var(--bg); }
+#stage { width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
+#stage.panning { cursor: grabbing; }
+#stage .route-casing { stroke-width: calc(var(--line-w) + 6); stroke: #000; opacity: 0.35; fill: none; stroke-linecap: round; stroke-linejoin: round; }
+#stage .route-line { fill: none; stroke-width: var(--line-w); stroke-linecap: round; stroke-linejoin: round; }
+#stage .route-line.muted { opacity: 0.18; }
+#stage .route-line.selected { stroke-width: calc(var(--line-w) + 3px); }
+#stage .route-hit { stroke: transparent; stroke-width: 22; fill: none; stroke-linecap: round; cursor: pointer; }
+#stage .real-line { fill: none; stroke: #3a4452; stroke-width: 2; stroke-dasharray: 4 4; opacity: 0.7; }
+#stage .station { fill: #fff; stroke: #1a1f26; stroke-width: 1.5; cursor: pointer; }
+#stage .station.transfer { fill: #ffd66b; }
+#stage .station.selected { stroke: var(--accent); stroke-width: 2.5; }
+#stage .anchor-ring { fill: none; stroke: #fff; stroke-width: 2; }
+#stage .anchor-hit { fill: transparent; cursor: grab; }
+#stage .anchor-hit:active { cursor: grabbing; }
+#stage .anchor-group.dragging .anchor-ring { stroke: var(--accent-2); }
+#stage .handle { fill: var(--accent); fill-opacity: 0.5; stroke: #fff; stroke-width: 1; cursor: grab; }
+#stage .handle:active { cursor: grabbing; }
+#stage .station-label { fill: var(--text); font-size: 10px; paint-order: stroke; stroke: #0e1116; stroke-width: 3px; pointer-events: none; }
+
+.hud {
+  position: absolute; left: 12px; bottom: 10px;
+  color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums;
+  background: rgba(14,17,22,0.7); padding: 3px 8px; border-radius: 5px;
+  pointer-events: none;
+}
+
+.inspect dl { margin: 0; }
+.inspect dt { color: var(--muted); font-size: 11px; margin-top: 6px; }
+.inspect dd { margin: 0 0 0 0; font-variant-numeric: tabular-nums; }
+.inspect .row { display: flex; gap: 6px; margin-top: 8px; }
+.help { margin: 0; padding-left: 16px; color: var(--muted); font-size: 11.5px; }
+.help li { margin-bottom: 3px; }
+.help b { color: var(--text); font-weight: 600; }
+
+.toast {
+  position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%) translateY(20px);
+  background: #fff; color: #11161c; padding: 9px 16px; border-radius: 8px;
+  font-size: 13px; opacity: 0; transition: opacity 0.2s, transform 0.2s;
+  pointer-events: none; z-index: 50; box-shadow: 0 6px 24px rgba(0,0,0,0.4);
+}
+.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
